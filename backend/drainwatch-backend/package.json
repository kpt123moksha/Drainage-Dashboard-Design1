{
  "name": "drainwatch-backend",
  "version": "1.0.0",
  "private": true,
  "description": "DrainWatch SQLite + Express backend using direct SQL (no PostgreSQL, no Prisma)",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
